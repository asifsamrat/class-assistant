@page "/student/dashboard"
@using ClassAssistant.Shared.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-white p-6 rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-4 border border-slate-200 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-2xl font-bold text-emerald-700 shadow-2xs">
                👨‍🎓
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-lg border border-emerald-200">Student Portal</span>
                    <span class="text-xs text-slate-500 font-medium">ID: @PortalData.Student.Id</span>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 mt-0.5">Welcome, @PortalData.Student.Name</h2>
                <p class="text-xs text-slate-500">Computer Science & Engineering Department</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" @onclick="OpenAbsenceModal" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded-xl text-xs font-bold flex items-center gap-2 transition cursor-pointer shadow-2xs">
                <span>📝 Submit Excuse Notice</span>
            </button>
            <button type="button" @onclick="StartFaceRegistration" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-md shadow-emerald-200 flex items-center gap-2 transition cursor-pointer">
                <span>📷 Register Face Biometrics</span>
            </button>
        </div>
    </div>

    <!-- Course Attendance Breakdown Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var c in PortalData.CourseStats)
        {
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4 hover:border-slate-300 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <h4 class="font-extrabold text-base text-slate-900">@c.Code</h4>
                        <p class="text-xs text-slate-500 truncate max-w-[180px] font-medium">@c.Title</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @(c.Status == "Good Standing" ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : c.Status == "Warning" ? "bg-amber-100 text-amber-800 border border-amber-300" : "bg-rose-100 text-rose-800 border border-rose-300")">
                        @c.Status
                    </span>
                </div>

                <div class="space-y-1.5">
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-500 font-medium">Attendance Ratio</span>
                        <span class="font-bold text-emerald-700">@c.Percentage%</span>
                    </div>
                    <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden border border-slate-200">
                        <div class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: @(c.Percentage)%"></div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2 pt-2 text-center text-[11px] border-t border-slate-100">
                    <div class="bg-slate-50 p-2 rounded-xl border border-slate-200/60">
                        <p class="text-slate-500 text-[10px] font-medium">Total</p>
                        <p class="font-bold text-slate-900">@c.TotalClasses</p>
                    </div>
                    <div class="bg-emerald-50/60 p-2 rounded-xl border border-emerald-100">
                        <p class="text-emerald-700 text-[10px] font-medium">Attended</p>
                        <p class="font-bold text-emerald-800">@c.AttendedClasses</p>
                    </div>
                    <div class="bg-rose-50/60 p-2 rounded-xl border border-rose-100">
                        <p class="text-rose-700 text-[10px] font-medium">Absent</p>
                        <p class="font-bold text-rose-800">@c.AbsentClasses</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Attendance Logs Table -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
        <h3 class="font-bold text-base text-slate-900">Recent Class Check-In Logs</h3>

        <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-100/90 text-slate-700 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-4">Course</th>
                        <th class="py-3.5 px-4">Date</th>
                        <th class="py-3.5 px-4">Check In</th>
                        <th class="py-3.5 px-4">Check Out</th>
                        <th class="py-3.5 px-4">Stay Time</th>
                        <th class="py-3.5 px-4 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @if (PortalData.AttendanceLogs.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400 font-medium">No attendance logs available yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in PortalData.AttendanceLogs)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-3.5 px-4 font-bold text-slate-900">@log.Course</td>
                                <td class="py-3.5 px-4 text-slate-600">@log.Date</td>
                                <td class="py-3.5 px-4 font-bold text-emerald-700">@log.CheckIn</td>
                                <td class="py-3.5 px-4 text-slate-500">@log.CheckOut</td>
                                <td class="py-3.5 px-4">@log.TotalMinutes mins</td>
                                <td class="py-3.5 px-4 text-right">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @(log.Status == "Present" ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-rose-100 text-rose-800 border border-rose-300")">
                                        @log.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Absence Notice Modal -->
@if (ShowAbsenceModal)
{
    <div class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white p-6 rounded-2xl max-w-md w-full border border-slate-200 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="font-bold text-base text-slate-900">Submit Absence Notice</h3>
                <button type="button" @onclick="() => ShowAbsenceModal = false" class="text-slate-400 hover:text-slate-800 text-xs font-bold px-2 py-1 bg-slate-100 rounded-lg">✕</button>
            </div>

            <EditForm FormName="studentNoticeForm" Model="NoticeForm" OnValidSubmit="SubmitNotice" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Course Code</label>
                    <select @bind="NoticeForm.Course" class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none">
                        <option value="">-- Select Course --</option>
                        @foreach (var c in PortalData.Student.Courses)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Date of Absence</label>
                    <input type="date" @bind="NoticeDateObj" class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Reason for Absence</label>
                    <textarea @bind="NoticeForm.Reason" rows="3" placeholder="Provide valid excuse reason..."
                              class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 rounded-xl p-3 text-xs text-slate-900 outline-none resize-none"></textarea>
                </div>

                <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md shadow-emerald-200 transition cursor-pointer">
                    Submit Excuse Notice
                </button>
            </EditForm>
        </div>
    </div>
}

<!-- Face Biometrics Registration Wizard Modal -->
@if (ShowFaceRegModal)
{
    <div class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white p-6 rounded-2xl max-w-lg w-full border border-slate-200 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="font-bold text-base text-slate-900">Biometric Face Dataset Wizard</h3>
                <button type="button" @onclick="StopFaceReg" class="text-slate-400 hover:text-slate-800 text-xs font-bold px-2 py-1 bg-slate-100 rounded-lg">✕</button>
            </div>

            <div class="relative bg-slate-900 rounded-xl border border-slate-200 aspect-video overflow-hidden flex items-center justify-center shadow-inner">
                <canvas id="regCanvas" class="w-full h-full object-cover"></canvas>
            </div>

            <!-- Progress Bar -->
            <div class="space-y-1.5">
                <div class="flex justify-between text-xs">
                    <span class="text-slate-500 font-medium">Captured Samples</span>
                    <span class="font-bold text-emerald-700">@CapturedSamples / 15</span>
                </div>
                <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden border border-slate-200">
                    <div class="h-full bg-emerald-500 transition-all duration-300" style="width: @((CapturedSamples / 15.0) * 100)%"></div>
                </div>
            </div>

            <p class="text-xs text-center text-slate-600 font-medium">
                @(RegStatusMessage ?? "Look directly into the camera. 15 face samples will be captured automatically.")
            </p>
        </div>
    </div>
}

@code {
    private StudentPortalDataResponse PortalData { get; set; } = new();
    private bool ShowAbsenceModal { get; set; } = false;
    private bool ShowFaceRegModal { get; set; } = false;

    private SubmitAbsenceNoticeRequest NoticeForm { get; set; } = new();
    private DateTime NoticeDateObj { get; set; } = DateTime.UtcNow.Date;

    private int CapturedSamples { get; set; } = 0;
    private string RegStatusMessage { get; set; } = string.Empty;
    private HubConnection? RegHubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadPortalData();
    }

    private async Task LoadPortalData()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<StudentPortalDataResponse>("/student/portal_data");
            if (res != null) PortalData = res;
        }
        catch { }
    }

    private void OpenAbsenceModal()
    {
        ShowAbsenceModal = true;
    }

    private async Task SubmitNotice()
    {
        NoticeForm.Date = NoticeDateObj.ToString("yyyy-MM-dd");
        try
        {
            var res = await Http.PostAsJsonAsync("/student/absence_notice", NoticeForm);
            if (res.IsSuccessStatusCode)
            {
                ShowAbsenceModal = false;
                await LoadPortalData();
            }
        }
        catch { }
    }

    private async Task StartFaceRegistration()
    {
        ShowFaceRegModal = true;
        CapturedSamples = 0;
        RegStatusMessage = "Initializing camera feed...";

        try
        {
            var regRes = await Http.PostAsync("/student/start_face_registration", null);
            var regData = await regRes.Content.ReadFromJsonAsync<Dictionary<string, object>>();

            int studentId = PortalData.Student.Id;

            RegHubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/attendance"))
                .WithAutomaticReconnect()
                .Build();

            RegHubConnection.On<byte[]>("register_processed_frame", async (frameBytes) =>
            {
                string base64 = Convert.ToBase64String(frameBytes);
                await JS.InvokeVoidAsync("cameraInterop.renderFrameToCanvas", "regCanvas", base64);
            });

            RegHubConnection.On<object>("register_progress", async (data) =>
            {
                if (data is System.Text.Json.JsonElement elem)
                {
                    if (elem.TryGetProperty("captured_count", out var cProp))
                        CapturedSamples = cProp.GetInt32();
                }
                await InvokeAsync(StateHasChanged);
            });

            RegHubConnection.On<object>("register_complete", async (data) =>
            {
                RegStatusMessage = "Face registered and model trained successfully!";
                await Task.Delay(2000);
                await StopFaceReg();
                await LoadPortalData();
            });

            await RegHubConnection.StartAsync();
            await JS.InvokeAsync<bool>("cameraInterop.startCamera", null, RegHubConnection);
            await JS.InvokeVoidAsync("cameraInterop.captureAndSendFrame", null, RegHubConnection, "", "", "", true, studentId);
        }
        catch (Exception ex)
        {
            RegStatusMessage = $"Registration failed: {ex.Message}";
        }
    }

    private async Task StopFaceReg()
    {
        ShowFaceRegModal = false;
        try
        {
            await JS.InvokeVoidAsync("cameraInterop.stopCamera");
            if (RegHubConnection != null)
            {
                await RegHubConnection.StopAsync();
                await RegHubConnection.DisposeAsync();
                RegHubConnection = null;
            }
        }
        catch { }
    }
}

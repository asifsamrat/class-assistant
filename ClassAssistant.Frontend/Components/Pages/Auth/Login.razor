@page "/login"
@page "/faculty"
@page "/student"
@page "/admin"
@page "/teacher"
@using ClassAssistant.Shared.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="min-h-[82vh] flex items-center justify-center py-8 px-4">
    <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-xl border border-slate-200 space-y-6">
        <!-- App Title Header -->
        <div class="text-center space-y-2">
            <div class="w-16 h-16 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center justify-center mx-auto text-3xl shadow-xs">
                🎓
            </div>
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">ClassAssistant AI</h2>
            <p class="text-xs text-slate-500">Select your portal role below to sign in</p>
        </div>

        <!-- Role Selector Tabs -->
        <div class="grid grid-cols-3 gap-1 bg-slate-100 p-1.5 rounded-xl border border-slate-200">
            <button type="button" @onclick='() => SetRole("faculty")'
                    class="py-2 text-xs font-bold rounded-lg transition @(ActiveRole == "faculty" ? "bg-white text-emerald-700 shadow-sm border border-slate-200" : "text-slate-600 hover:text-slate-900")">
                Faculty
            </button>
            <button type="button" @onclick='() => SetRole("student")'
                    class="py-2 text-xs font-bold rounded-lg transition @(ActiveRole == "student" ? "bg-white text-emerald-700 shadow-sm border border-slate-200" : "text-slate-600 hover:text-slate-900")">
                Student
            </button>
            <button type="button" @onclick='() => SetRole("admin")'
                    class="py-2 text-xs font-bold rounded-lg transition @(ActiveRole == "admin" ? "bg-white text-emerald-700 shadow-sm border border-slate-200" : "text-slate-600 hover:text-slate-900")">
                Admin
            </button>
        </div>

        <!-- Error Banner -->
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="p-3.5 text-xs text-rose-800 bg-rose-50 border border-rose-200 rounded-xl flex items-center gap-2 font-medium">
                <span>⚠️</span>
                <span>@ErrorMessage</span>
            </div>
        }

        <!-- Login Form -->
        <EditForm FormName="loginForm" Model="LoginForm" OnValidSubmit="HandleLogin" class="space-y-4">
            @if (ActiveRole == "student")
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Student ID</label>
                    <InputText @bind-Value="LoginForm.StudentId" placeholder="e.g. 221902117"
                               class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-100 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 outline-none transition" />
                </div>
            }
            else
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        @(ActiveRole == "admin" ? "Admin Email or Username" : "Faculty Email")
                    </label>
                    <InputText @bind-Value="LoginForm.Email" placeholder="@(ActiveRole == "admin" ? "admin@green.edu.bd" : "teacher@green.edu.bd")"
                               class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-100 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 outline-none transition" />
                </div>
            }

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Password</label>
                <div class="relative">
                    <InputText @bind-Value="LoginForm.Password" type="@(ShowPassword ? "text" : "password")" placeholder="••••••••"
                               class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-100 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 outline-none transition pr-12" />
                    <button type="button" @onclick="TogglePasswordVisibility" class="absolute right-3.5 top-2.5 text-slate-500 hover:text-slate-800 text-xs font-semibold">
                        @(ShowPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            <button type="submit" disabled="@IsLoading"
                    class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl transition shadow-md shadow-emerald-200 flex items-center justify-center gap-2 cursor-pointer">
                @if (IsLoading)
                {
                    <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>Sign In to Portal</span>
                }
            </button>
        </EditForm>

        <!-- Credentials Hint -->
        <div class="pt-4 border-t border-slate-200 text-center text-xs text-slate-500 space-y-1">
            <p><strong class="text-slate-800">Demo Credentials:</strong></p>
            <p>Faculty: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">teacher@green.edu.bd</code> / <code class="bg-slate-100 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">teacher123</code></p>
            <p>Student: ID <code class="bg-slate-100 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">221902117</code> / <code class="bg-slate-100 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">student123</code></p>
            <p>Admin: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">admin@green.edu.bd</code> / <code class="bg-slate-100 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">admin123</code></p>
        </div>
    </div>
</div>

@code {
    private string ActiveRole { get; set; } = "faculty";
    private bool ShowPassword { get; set; } = false;
    private bool IsLoading { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;

    private LoginRequest LoginForm { get; set; } = new();

    protected override void OnInitialized()
    {
        var uri = Navigation.Uri.ToLower();
        if (uri.Contains("/student")) ActiveRole = "student";
        else if (uri.Contains("/admin")) ActiveRole = "admin";
        else ActiveRole = "faculty";
    }

    private void SetRole(string role)
    {
        ActiveRole = role;
        ErrorMessage = string.Empty;
    }

    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            string endpoint = ActiveRole switch
            {
                "student" => "/student/signin",
                "admin" => "/admin/signin",
                _ => "/faculty/signin"
            };

            var response = await Http.PostAsJsonAsync(endpoint, LoginForm);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (result != null && result.Msg == "success")
                {
                    string targetPath = result.Role switch
                    {
                        "admin" => "/admin/dashboard",
                        "student" => "/student/dashboard",
                        _ => "/faculty/dashboard"
                    };
                    Navigation.NavigateTo(targetPath);
                    return;
                }
            }

            string rawContent = await response.Content.ReadAsStringAsync();
            if (rawContent.TrimStart().StartsWith("{"))
            {
                try
                {
                    var errObj = System.Text.Json.JsonSerializer.Deserialize<AuthResponse>(rawContent, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    ErrorMessage = !string.IsNullOrEmpty(errObj?.Msg) ? errObj.Msg : "Invalid login credentials. Please try again.";
                }
                catch
                {
                    ErrorMessage = "Invalid login credentials. Please verify your details.";
                }
            }
            else
            {
                ErrorMessage = "Backend or Database service is unreachable. Please verify PostgreSQL connection.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Connection failed: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

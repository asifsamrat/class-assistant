@page "/faculty/dashboard"
@page "/teacher/dashboard"
@page "/attendance-system"
@using ClassAssistant.Shared.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="glass-panel p-6 rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-4 border border-slate-800">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-500/20 text-emerald-400 rounded-lg border border-emerald-500/30">Faculty Portal</span>
                <span class="text-xs text-slate-400">Live Attendance Session</span>
            </div>
            <h2 class="text-2xl font-bold text-white mt-1">Instructor Control Dashboard</h2>
            <p class="text-xs text-slate-400">Stream webcam frames to AI engine and persist course attendance to PostgreSQL</p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" @onclick="ShowNoticesModal" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-xl text-xs font-semibold flex items-center gap-2 transition">
                <span>📩 Absence Notices</span>
                @if (AbsenceNotices.Any(n => n.Status == "Submitted"))
                {
                    <span class="bg-amber-500 text-slate-950 font-extrabold text-[10px] px-1.5 py-0.5 rounded-full">
                        @AbsenceNotices.Count(n => n.Status == "Submitted")
                    </span>
                }
            </button>
            <button type="button" @onclick="ExportToExcel" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold shadow-lg shadow-emerald-950/50 flex items-center gap-2 transition">
                <span>📊 Export Matrix (Excel)</span>
            </button>
        </div>
    </div>

    <!-- Live Stream Control Bar & Video Viewport -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Live Camera Viewport -->
        <div class="lg:col-span-2 glass-panel p-5 rounded-2xl border border-slate-800 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full @(IsStreaming ? "bg-emerald-500 animate-pulse" : "bg-slate-600")"></span>
                    <h3 class="font-bold text-sm text-slate-200">Live AI Webcam Feed</h3>
                </div>
                <div class="flex items-center gap-2">
                    @if (!IsStreaming)
                    {
                        <button type="button" @onclick="StartStreaming" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition shadow-md">
                            ▶️ Start Camera
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="StopStreaming" class="px-4 py-1.5 bg-rose-600/80 hover:bg-rose-600 text-white text-xs font-semibold rounded-lg transition shadow-md">
                            ⏹️ Stop Camera
                        </button>
                    }
                </div>
            </div>

            <!-- Canvas Viewport -->
            <div class="relative bg-slate-950 rounded-xl border border-slate-800/80 aspect-video flex items-center justify-center overflow-hidden">
                <canvas id="facultyCanvas" class="w-full h-full object-cover"></canvas>
                @if (!IsStreaming)
                {
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 bg-slate-950/80 backdrop-blur-xs">
                        <div class="w-14 h-14 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-2xl text-slate-500 mb-3">
                            📷
                        </div>
                        <p class="text-sm font-semibold text-slate-300">Camera Feed Paused</p>
                        <p class="text-xs text-slate-500 max-w-xs mt-1">Click "Start Camera" above to initiate real-time multi-student face recognition</p>
                    </div>
                }
            </div>
        </div>

        <!-- Course & Date Scoping Form -->
        <div class="glass-panel p-5 rounded-2xl border border-slate-800 space-y-4">
            <h3 class="font-bold text-sm text-slate-200 border-b border-slate-800 pb-3">Session Configuration</h3>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Active Course</label>
                <select @bind="SelectedCourseCode" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 outline-none">
                    <option value="">-- All Assigned Courses --</option>
                    @foreach (var c in AssignedCourses)
                    {
                        <option value="@c.Code">@c.Code - @c.Title</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Session Date</label>
                <input type="date" @bind="SelectedDate" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 outline-none" />
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Search Matrix</label>
                <input type="text" @bind="SearchQuery" @bind:event="oninput" placeholder="Search student name or ID..."
                       class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 outline-none" />
            </div>

            <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-xs text-slate-400 space-y-1">
                <p>🔹 Multi-student deep face recognition enabled.</p>
                <p>🔹 Attendance auto-synced to EF Core PostgreSQL.</p>
            </div>
        </div>
    </div>

    <!-- Attendance Matrix Table -->
    <div class="glass-panel p-6 rounded-2xl border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="font-bold text-base text-white">Attendance Summary Matrix</h3>
            <span class="text-xs text-slate-400">Total Records: @FilteredAttendanceLogs.Count</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
                <thead class="bg-slate-900/80 text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-800">
                    <tr>
                        <th class="py-3 px-4">Student</th>
                        <th class="py-3 px-4">Course</th>
                        <th class="py-3 px-4">Date</th>
                        <th class="py-3 px-4">Check In</th>
                        <th class="py-3 px-4">Check Out</th>
                        <th class="py-3 px-4">Stay Time</th>
                        <th class="py-3 px-4 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    @if (FilteredAttendanceLogs.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-500">No attendance records found for selected filters.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in FilteredAttendanceLogs)
                        {
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="py-3 px-4 font-semibold text-white">@log.Course</td>
                                <td class="py-3 px-4">@log.Course</td>
                                <td class="py-3 px-4">@log.Date</td>
                                <td class="py-3 px-4 text-emerald-400">@log.CheckIn</td>
                                <td class="py-3 px-4 text-slate-400">@log.CheckOut</td>
                                <td class="py-3 px-4">@log.TotalMinutes mins</td>
                                <td class="py-3 px-4 text-right">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @(log.Status == "Present" ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" : "bg-rose-500/20 text-rose-400 border border-rose-500/30")">
                                        @log.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Absence Notices Modal -->
@if (ShowNoticesModalFlag)
{
    <div class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="glass-panel p-6 rounded-2xl max-w-2xl w-full border border-slate-800 space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="font-bold text-base text-white">Student Absence Excuse Notices</h3>
                <button type="button" @onclick="() => ShowNoticesModalFlag = false" class="text-slate-400 hover:text-white text-xs font-bold px-2 py-1 bg-slate-800 rounded-lg">✕</button>
            </div>

            <div class="space-y-3">
                @if (AbsenceNotices.Count == 0)
                {
                    <p class="text-center py-6 text-xs text-slate-500">No student absence notices submitted yet.</p>
                }
                else
                {
                    @foreach (var notice in AbsenceNotices)
                    {
                        <div class="p-4 bg-slate-900/90 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-sm text-emerald-400">@notice.StudentName (ID: @notice.StudentId)</span>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full @(notice.Status == "Approved" ? "bg-emerald-500/20 text-emerald-400" : notice.Status == "Rejected" ? "bg-rose-500/20 text-rose-400" : "bg-amber-500/20 text-amber-400")">
                                    @notice.Status
                                </span>
                            </div>
                            <p class="text-xs text-slate-300"><strong>Course:</strong> @notice.Course | <strong>Date:</strong> @notice.Date</p>
                            <p class="text-xs text-slate-400 bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80">"@notice.Reason"</p>

                            @if (notice.Status == "Submitted")
                            {
                                <div class="flex items-center gap-2 pt-1 justify-end">
                                    <button type="button" @onclick='() => UpdateNoticeStatus(notice.Id, "Approved")'
                                            class="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg shadow-sm">
                                        Accept Excuse
                                    </button>
                                    <button type="button" @onclick='() => UpdateNoticeStatus(notice.Id, "Rejected")'
                                            class="px-3 py-1 bg-rose-600/80 hover:bg-rose-600 text-white text-xs font-semibold rounded-lg shadow-sm">
                                        Reject
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private bool IsStreaming { get; set; } = false;
    private string SelectedCourseCode { get; set; } = string.Empty;
    private DateTime SelectedDate { get; set; } = DateTime.UtcNow.Date;
    private string SearchQuery { get; set; } = string.Empty;
    private bool ShowNoticesModalFlag { get; set; } = false;

    private List<CourseDto> AssignedCourses { get; set; } = new();
    private List<AttendanceLogDto> AttendanceLogs { get; set; } = new();
    private List<AbsenceNoticeDto> AbsenceNotices { get; set; } = new();

    private HubConnection? HubConnection;

    private List<AttendanceLogDto> FilteredAttendanceLogs => AttendanceLogs
        .Where(l => string.IsNullOrEmpty(SelectedCourseCode) || l.Course.Equals(SelectedCourseCode, StringComparison.OrdinalIgnoreCase))
        .Where(l => string.IsNullOrEmpty(SearchQuery) || l.Course.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
        await LoadAttendanceData();
        await LoadNotices();
    }

    private async Task LoadCourses()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<CourseDto>>("/faculty/my_courses");
            AssignedCourses = res ?? new();
        }
        catch { }
    }

    private async Task LoadAttendanceData()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<AttendanceLogDto>>("/time_logs");
            AttendanceLogs = res ?? new();
        }
        catch { }
    }

    private async Task LoadNotices()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<AbsenceNoticeDto>>("/faculty/absence_notices");
            AbsenceNotices = res ?? new();
        }
        catch { }
    }

    private async Task StartStreaming()
    {
        IsStreaming = true;
        try
        {
            HubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/attendance"))
                .WithAutomaticReconnect()
                .Build();

            HubConnection.On<byte[]>("processed_frame", async (frameBytes) =>
            {
                string base64 = Convert.ToBase64String(frameBytes);
                await JS.InvokeVoidAsync("cameraInterop.renderFrameToCanvas", "facultyCanvas", base64);
            });

            await HubConnection.StartAsync();
            await HubConnection.InvokeAsync("SetActiveCourse", new
            {
                course_code = SelectedCourseCode,
                selected_date = SelectedDate.ToString("yyyy-MM-dd")
            });

            await JS.InvokeAsync<bool>("cameraInterop.startCamera", null, HubConnection);
            await JS.InvokeVoidAsync("cameraInterop.captureAndSendFrame", null, HubConnection, SelectedCourseCode, "", SelectedDate.ToString("yyyy-MM-dd"), false, null);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[StartStreaming ERROR]: {ex.Message}");
        }
    }

    private async Task StopStreaming()
    {
        IsStreaming = false;
        try
        {
            await JS.InvokeVoidAsync("cameraInterop.stopCamera");
            if (HubConnection != null)
            {
                await HubConnection.StopAsync();
                await HubConnection.DisposeAsync();
                HubConnection = null;
            }
        }
        catch { }
    }

    private void ShowNoticesModal()
    {
        ShowNoticesModalFlag = true;
    }

    private async Task UpdateNoticeStatus(int noticeId, string status)
    {
        try
        {
            var res = await Http.PutAsJsonAsync($"/faculty/absence_notices/{noticeId}", new UpdateNoticeStatusRequest { Status = status });
            if (res.IsSuccessStatusCode)
            {
                await LoadNotices();
                await LoadAttendanceData();
            }
        }
        catch { }
    }

    private void ExportToExcel()
    {
        Navigation.NavigateTo($"/export_attendance_matrix?courseCode={SelectedCourseCode}&date={SelectedDate:yyyy-MM-dd}", forceLoad: true);
    }
}
